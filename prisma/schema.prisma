// PhysioCare Clinic OS — data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  STAFF
}

enum LeadSource {
  DIRECT
  REFERRAL
  GOOGLE
  FACEBOOK
  WALK_IN
  WHATSAPP
  INSTAGRAM
}

enum PackageStatus {
  ACTIVE
  FROZEN
  COMPLETED
  REFUNDED
}

enum ClinicType {
  PHYSIOTHERAPY
  DENTAL
  GENERAL
  ORTHO
  HOSPITAL
}

enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceSubject {
  STAFF
  PATIENT
}

enum AttendanceStatus {
  UNMARKED
  PRESENT
  LEAVE
  ABSENT
  LATE
}

enum CampaignType {
  CAMPAIGN
  WORKSHOP
}

enum ReferralType {
  DOCTOR
  OTHER
}

enum RatingType {
  PATIENT
  DEPT_HEAD
}

enum FacilityType {
  CLINIC
  HOSPITAL
}

enum VisitType {
  OPD
  IPD
  EMERGENCY
}

enum VisitStatus {
  WAITING
  IN_CONSULT
  COMPLETED
  CANCELLED
}

model Tenant {
  id             String       @id @default(uuid())
  name           String
  gstNumber      String?
  phone          String?
  email          String?
  address        String?
  facilityType   FacilityType @default(CLINIC)
  uhidPrefix     String       @default("UH")
  uhidSeq        Int          @default(0)
  invoiceSeq     Int          @default(0)
  clinicType     ClinicType   @default(PHYSIOTHERAPY)
  enabledModules String[]     @default([])
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  branches      Branch[]
  users         User[]
  patients      Patient[]
  invoices      Invoice[]
  appointments  Appointment[]
  attendance    AttendanceRecord[]
  campaigns     Campaign[]
  referrals     Referral[]
  ratings       Rating[]
  auditLogs     AuditLog[]
  packages      Package[]
  visits        Visit[]
  vitals        Vitals[]
  prescriptions Prescription[]
  serviceItems  ServiceItem[]
}

model Branch {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  city     String?

  users        User[]
  patients     Patient[]
  appointments Appointment[]

  deletedAt DateTime?
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  specialty    String?
  title        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  appointments     Appointment[]      @relation("DoctorAppointments")
  clinicalNotes    ClinicalNote[]
  attendance       AttendanceRecord[]
  ratingsGiven     Rating[]           @relation("RatingDoctor")
  auditLogs        AuditLog[]
  doctorVisits     Visit[]            @relation("DoctorVisits")
  vitalsRecorded   Vitals[]
  prescriptions    Prescription[]
  invoicesCreated  Invoice[]          @relation("InvoiceCreatedBy")
  paymentsReceived Payment[]          @relation("PaymentReceivedBy")
}

model Patient {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id])
  name           String
  phone          String
  gender         String?
  address        String?
  reason         String?
  leadSource     LeadSource?
  referralDoctor String?
  notes          String?
  uhid           String?
  dob            DateTime?
  bloodGroup     String?
  allergies      String?
  abhaId         String?
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  packages      Package[]
  invoices      Invoice[]
  appointments  Appointment[]
  clinicalNotes ClinicalNote[]
  attendance    AttendanceRecord[]
  visits        Visit[]
  vitals        Vitals[]
  prescriptions Prescription[]

  @@unique([tenantId, uhid])
}

model Package {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  name          String
  totalSessions Int
  usedSessions  Int           @default(0)
  price         Decimal       @db.Decimal(10, 2)
  status        PackageStatus @default(ACTIVE)
  startDate     DateTime      @default(now())
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
}

model Invoice {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  patientId  String
  patient    Patient       @relation(fields: [patientId], references: [id])
  number     String
  date       DateTime      @default(now())
  subtotal   Decimal       @db.Decimal(10, 2)
  gst        Decimal       @db.Decimal(10, 2)
  total      Decimal       @db.Decimal(10, 2)
  paidAmount Decimal       @default(0) @db.Decimal(10, 2)
  status     InvoiceStatus @default(UNPAID)
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?

  visitId      String?
  visit        Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  discount     Decimal   @default(0) @db.Decimal(10, 2)
  notes        String?
  cancelledAt  DateTime?
  cancelReason String?
  createdById  String?
  createdBy    User?     @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([visitId])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  qty         Int
  unitPrice   Decimal @db.Decimal(10, 2)
  gstPercent  Decimal @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0)
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  method    String
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())

  reference    String?
  clientRef    String?
  receivedById String?
  receivedBy   User?   @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@unique([invoiceId, clientRef])
}

model ServiceItem {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  category   String   @default("Consultation")
  price      Decimal  @db.Decimal(10, 2)
  gstPercent Decimal  @default(0) @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([tenantId, name])
}

model Appointment {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  branchId    String?
  branch      Branch?           @relation(fields: [branchId], references: [id])
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  datetime    DateTime
  durationMin Int               @default(45)
  notes       String?
  status      AppointmentStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  clinicalNotes ClinicalNote[]
  visits        Visit[]
}

model ClinicalNote {
  id            String       @id @default(uuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  authorId      String
  author        User         @relation(fields: [authorId], references: [id])
  note          String
  date          DateTime     @default(now())
  deletedAt     DateTime?
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  date      DateTime          @db.Date
  subject   AttendanceSubject
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  patientId String?
  patient   Patient?          @relation(fields: [patientId], references: [id])
  status    AttendanceStatus  @default(UNMARKED)
  createdAt DateTime          @default(now())

  @@unique([tenantId, date, userId])
  @@unique([tenantId, date, patientId])
}

model Campaign {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  type        CampaignType
  startDate   DateTime
  endDate     DateTime
  cost        Decimal      @db.Decimal(10, 2)
  leads       Int          @default(0)
  conversions Int          @default(0)
  revenue     Decimal      @default(0) @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
}

model Referral {
  id               String       @id @default(uuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  referrerName     String
  type             ReferralType
  revenueGenerated Decimal      @db.Decimal(10, 2)
  date             DateTime     @default(now())
  deletedAt        DateTime?
}

model Rating {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  doctorId  String
  doctor    User       @relation("RatingDoctor", fields: [doctorId], references: [id])
  type      RatingType
  scores    Json
  comment   String?
  date      DateTime   @default(now())
  deletedAt DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  diff      Json?
  timestamp DateTime @default(now())
}

// ── Hospital core (slice 1): visit/encounter, vitals, prescription ──────────

/// One patient visit (OPD/IPD/Emergency). Mirrors the OpenMRS visit→encounter idea.
model Visit {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  branchId       String?
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         User         @relation("DoctorVisits", fields: [doctorId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  type           VisitType    @default(OPD)
  status         VisitStatus  @default(WAITING)
  /// Calendar day of the visit in IST (YYYY-MM-DD); token numbers restart each day.
  tokenDate      String
  tokenNumber    Int
  chiefComplaint String?
  diagnosis      String?
  advice         String?
  followUpDate   DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  vitals       Vitals[]
  prescription Prescription?
  invoices     Invoice[]

  @@unique([tenantId, tokenDate, tokenNumber])
  @@index([tenantId, tokenDate, status])
  @@index([patientId])
}

model Vitals {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  visitId      String
  visit        Visit    @relation(fields: [visitId], references: [id])
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  systolic     Int?
  diastolic    Int?
  pulse        Int?
  respRate     Int?
  spo2         Int?
  tempC        Decimal? @db.Decimal(4, 1)
  weightKg     Decimal? @db.Decimal(5, 1)
  heightCm     Decimal? @db.Decimal(5, 1)
  bmi          Decimal? @db.Decimal(4, 1)
  notes        String?
  recordedAt   DateTime @default(now())

  @@index([visitId])
}

/// One prescription per visit (v1). Generic name is required (NMC generic-prescribing rule).
model Prescription {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  visitId   String   @unique
  visit     Visit    @relation(fields: [visitId], references: [id])
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    User     @relation(fields: [doctorId], references: [id])
  notes     String?
  createdAt DateTime @default(now())

  items PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  genericName    String
  brandName      String?
  form           String?
  strength       String?
  dose           String?
  /// e.g. "1-0-1" (morning-afternoon-night) or "SOS"
  frequency      String
  durationDays   Int?
  route          String?
  instructions   String?

  @@index([prescriptionId])
}
