// PhysioCare Clinic OS — data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  /// Platform onboarding team: creates clinics, sets modules and trials. Never sees clinic data.
  ONBOARDING
  CLINIC_ADMIN
  DOCTOR
  STAFF
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum LeadSource {
  DIRECT
  REFERRAL
  GOOGLE
  FACEBOOK
  WALK_IN
  WHATSAPP
  INSTAGRAM
}

enum PackageStatus {
  ACTIVE
  FROZEN
  COMPLETED
  REFUNDED
}

enum ClinicType {
  PHYSIOTHERAPY
  DENTAL
  GENERAL
  ORTHO
  HOSPITAL
}

enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceSubject {
  STAFF
  PATIENT
}

enum AttendanceStatus {
  UNMARKED
  PRESENT
  LEAVE
  ABSENT
  LATE
}

enum CampaignType {
  CAMPAIGN
  WORKSHOP
}

enum ReferralType {
  DOCTOR
  OTHER
}

enum RatingType {
  PATIENT
  DEPT_HEAD
}

enum FacilityType {
  CLINIC
  HOSPITAL
}

enum VisitType {
  OPD
  IPD
  EMERGENCY
}

enum VisitStatus {
  WAITING
  IN_CONSULT
  COMPLETED
  CANCELLED
}

model Tenant {
  id                 String             @id @default(uuid())
  name               String
  gstNumber          String?
  phone              String?
  email              String?
  address            String?
  facilityType       FacilityType       @default(CLINIC)
  uhidPrefix         String             @default("UH")
  uhidSeq            Int                @default(0)
  invoiceSeq         Int                @default(0)
  clinicType         ClinicType         @default(PHYSIOTHERAPY)
  enabledModules     String[]           @default([])
  /// Existing clinics are grandfathered as ACTIVE with no end date; new clinics start a TRIAL.
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  plan               String?
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  /// Paid up to this moment (null = no end date).
  paidThrough        DateTime?
  subscriptionNote   String?
  /// When false only the platform team can change the clinic's modules.
  selfServiceModules Boolean            @default(true)
  createdAt          DateTime           @default(now())
  deletedAt          DateTime?

  branches      Branch[]
  users         User[]
  patients      Patient[]
  invoices      Invoice[]
  appointments  Appointment[]
  attendance    AttendanceRecord[]
  campaigns     Campaign[]
  referrals     Referral[]
  ratings       Rating[]
  auditLogs     AuditLog[]
  packages      Package[]
  visits        Visit[]
  vitals        Vitals[]
  prescriptions Prescription[]
  serviceItems  ServiceItem[]
  suppliers     Supplier[]
  stockItems    StockItem[]
  stockBatches  StockBatch[]
  stockMoves    StockMovement[]
  dispensations Dispensation[]
  labSeq        Int                @default(0)
  imagingSeq    Int                @default(0)
  admissionSeq  Int                @default(0)

  toothRecords       ToothRecord[]
  treatmentPlans     TreatmentPlan[]
  exerciseTemplates  ExerciseTemplate[]
  exercisePlans      ExercisePlan[]
  labTests           LabTest[]
  labOrders          LabOrder[]
  imagingTypes       ImagingStudyType[]
  imagingOrders      ImagingOrder[]
  wards              Ward[]
  beds               Bed[]
  admissions         Admission[]
  dischargeSummaries DischargeSummary[]
}

model Branch {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  city     String?

  users        User[]
  patients     Patient[]
  appointments Appointment[]

  deletedAt DateTime?
}

model User {
  id                 String    @id @default(uuid())
  tenantId           String?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id])
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  specialty          String?
  title              String?
  isActive           Boolean   @default(true)
  /// Set for temporary passwords handed out by the platform team: the user must choose their own first.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?

  appointments            Appointment[]      @relation("DoctorAppointments")
  clinicalNotes           ClinicalNote[]
  attendance              AttendanceRecord[]
  ratingsGiven            Rating[]           @relation("RatingDoctor")
  auditLogs               AuditLog[]
  doctorVisits            Visit[]            @relation("DoctorVisits")
  vitalsRecorded          Vitals[]
  prescriptions           Prescription[]
  invoicesCreated         Invoice[]          @relation("InvoiceCreatedBy")
  paymentsReceived        Payment[]          @relation("PaymentReceivedBy")
  stockMoves              StockMovement[]
  dispensations           Dispensation[]
  exercisePlansPrescribed ExercisePlan[]     @relation("ExerciseDoctor")
  labOrdersMade           LabOrder[]         @relation("LabOrderedBy")
  imagingOrdersMade       ImagingOrder[]     @relation("ImagingOrderedBy")
  admissionsAsDoctor      Admission[]        @relation("AdmissionDoctor")
  dischargesAsDoctor      DischargeSummary[] @relation("DischargeDoctor")
}

model Patient {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id])
  name           String
  phone          String
  gender         String?
  address        String?
  reason         String?
  leadSource     LeadSource?
  referralDoctor String?
  notes          String?
  uhid           String?
  dob            DateTime?
  bloodGroup     String?
  allergies      String?
  abhaId         String?
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  packages           Package[]
  invoices           Invoice[]
  appointments       Appointment[]
  clinicalNotes      ClinicalNote[]
  attendance         AttendanceRecord[]
  visits             Visit[]
  vitals             Vitals[]
  prescriptions      Prescription[]
  dispensations      Dispensation[]
  toothRecords       ToothRecord[]
  treatmentPlans     TreatmentPlan[]
  exercisePlans      ExercisePlan[]
  labOrders          LabOrder[]
  imagingOrders      ImagingOrder[]
  admissions         Admission[]
  dischargeSummaries DischargeSummary[]

  @@unique([tenantId, uhid])
}

model Package {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  name          String
  totalSessions Int
  usedSessions  Int           @default(0)
  price         Decimal       @db.Decimal(10, 2)
  status        PackageStatus @default(ACTIVE)
  startDate     DateTime      @default(now())
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
}

model Invoice {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  patientId  String
  patient    Patient       @relation(fields: [patientId], references: [id])
  number     String
  date       DateTime      @default(now())
  subtotal   Decimal       @db.Decimal(10, 2)
  gst        Decimal       @db.Decimal(10, 2)
  total      Decimal       @db.Decimal(10, 2)
  paidAmount Decimal       @default(0) @db.Decimal(10, 2)
  status     InvoiceStatus @default(UNPAID)
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?

  visitId      String?
  visit        Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  discount     Decimal   @default(0) @db.Decimal(10, 2)
  notes        String?
  cancelledAt  DateTime?
  cancelReason String?
  createdById  String?
  createdBy    User?     @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lineItems     InvoiceLineItem[]
  payments      Payment[]
  dispensations Dispensation[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([visitId])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  qty         Int
  unitPrice   Decimal @db.Decimal(10, 2)
  gstPercent  Decimal @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0)
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  method    String
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())

  reference    String?
  clientRef    String?
  receivedById String?
  receivedBy   User?   @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@unique([invoiceId, clientRef])
}

model ServiceItem {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  category   String   @default("Consultation")
  price      Decimal  @db.Decimal(10, 2)
  gstPercent Decimal  @default(0) @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([tenantId, name])
}

model Appointment {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  branchId    String?
  branch      Branch?           @relation(fields: [branchId], references: [id])
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  datetime    DateTime
  durationMin Int               @default(45)
  notes       String?
  status      AppointmentStatus @default(SCHEDULED)
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  clinicalNotes ClinicalNote[]
  visits        Visit[]
}

model ClinicalNote {
  id            String       @id @default(uuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  authorId      String
  author        User         @relation(fields: [authorId], references: [id])
  note          String
  date          DateTime     @default(now())
  deletedAt     DateTime?
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  date      DateTime          @db.Date
  subject   AttendanceSubject
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  patientId String?
  patient   Patient?          @relation(fields: [patientId], references: [id])
  status    AttendanceStatus  @default(UNMARKED)
  createdAt DateTime          @default(now())

  @@unique([tenantId, date, userId])
  @@unique([tenantId, date, patientId])
}

model Campaign {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  type        CampaignType
  startDate   DateTime
  endDate     DateTime
  cost        Decimal      @db.Decimal(10, 2)
  leads       Int          @default(0)
  conversions Int          @default(0)
  revenue     Decimal      @default(0) @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
}

model Referral {
  id               String       @id @default(uuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  referrerName     String
  type             ReferralType
  revenueGenerated Decimal      @db.Decimal(10, 2)
  date             DateTime     @default(now())
  deletedAt        DateTime?
}

model Rating {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  doctorId  String
  doctor    User       @relation("RatingDoctor", fields: [doctorId], references: [id])
  type      RatingType
  scores    Json
  comment   String?
  date      DateTime   @default(now())
  deletedAt DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  diff      Json?
  timestamp DateTime @default(now())
}

// ── Hospital core (slice 1): visit/encounter, vitals, prescription ──────────

/// One patient visit (OPD/IPD/Emergency). Mirrors the OpenMRS visit→encounter idea.
model Visit {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  branchId       String?
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         User         @relation("DoctorVisits", fields: [doctorId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  type           VisitType    @default(OPD)
  status         VisitStatus  @default(WAITING)
  /// Calendar day of the visit in IST (YYYY-MM-DD); token numbers restart each day.
  tokenDate      String
  tokenNumber    Int
  chiefComplaint String?
  diagnosis      String?
  advice         String?
  followUpDate   DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  vitals       Vitals[]
  prescription Prescription?
  invoices     Invoice[]

  @@unique([tenantId, tokenDate, tokenNumber])
  @@index([tenantId, tokenDate, status])
  @@index([patientId])
}

model Vitals {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  visitId      String
  visit        Visit    @relation(fields: [visitId], references: [id])
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  systolic     Int?
  diastolic    Int?
  pulse        Int?
  respRate     Int?
  spo2         Int?
  tempC        Decimal? @db.Decimal(4, 1)
  weightKg     Decimal? @db.Decimal(5, 1)
  heightCm     Decimal? @db.Decimal(5, 1)
  bmi          Decimal? @db.Decimal(4, 1)
  notes        String?
  recordedAt   DateTime @default(now())

  @@index([visitId])
}

/// One prescription per visit (v1). Generic name is required (NMC generic-prescribing rule).
model Prescription {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  visitId   String   @unique
  visit     Visit    @relation(fields: [visitId], references: [id])
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    User     @relation(fields: [doctorId], references: [id])
  notes     String?
  createdAt DateTime @default(now())

  items         PrescriptionItem[]
  dispensations Dispensation[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  genericName    String
  brandName      String?
  form           String?
  strength       String?
  dose           String?
  /// e.g. "1-0-1" (morning-afternoon-night) or "SOS"
  frequency      String
  durationDays   Int?
  route          String?
  instructions   String?

  @@index([prescriptionId])
}

enum StockMoveType {
  RECEIPT
  DISPENSE
  ADJUSTMENT
  WRITE_OFF
  VOID_RETURN
}

enum DispensationStatus {
  COMPLETED
  VOIDED
}

model Supplier {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  phone     String?
  gstin     String?
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  batches StockBatch[]

  @@unique([tenantId, name])
}

/// A thing the clinic stocks (medicine or consumable). Quantities are whole units (tablets, bottles, ...).
model StockItem {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  /// Generic name for medicines (matches prescriptions); plain name for consumables.
  name         String
  brand        String?
  form         String?
  strength     String?
  unit         String    @default("unit")
  category     String    @default("Medicine")
  hsn          String?
  gstPercent   Decimal   @default(0) @db.Decimal(5, 2)
  reorderLevel Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  batches   StockBatch[]
  movements StockMovement[]
  lines     DispensationLine[]

  @@index([tenantId, name])
}

model StockBatch {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  itemId     String
  item       StockItem @relation(fields: [itemId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  batchNo    String
  /// Last day the batch may be dispensed.
  expiryDate DateTime? @db.Date
  qtyOnHand  Int       @default(0)
  costPrice  Decimal   @default(0) @db.Decimal(10, 2)
  /// Selling price per unit (MRP).
  salePrice  Decimal   @db.Decimal(10, 2)
  receivedAt DateTime  @default(now())
  deletedAt  DateTime?

  movements StockMovement[]
  lines     DispensationLine[]

  @@unique([itemId, batchNo])
  @@index([tenantId, itemId])
}

/// Append-only ledger: every change to a batch's quantity has exactly one row here.
model StockMovement {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  itemId         String
  item           StockItem     @relation(fields: [itemId], references: [id])
  batchId        String
  batch          StockBatch    @relation(fields: [batchId], references: [id])
  type           StockMoveType
  /// Signed: positive adds stock, negative removes it.
  qty            Int
  note           String?
  dispensationId String?
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([tenantId, itemId])
  @@index([batchId])
}

model Dispensation {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  visitId        String?
  prescriptionId String?
  prescription   Prescription?      @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  invoiceId      String?
  invoice        Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status         DispensationStatus @default(COMPLETED)
  voidReason     String?
  voidedAt       DateTime?
  /// Client-generated id so a double click or retry cannot dispense twice.
  clientRef      String?
  total          Decimal            @default(0) @db.Decimal(10, 2)
  notes          String?
  dispensedById  String?
  dispensedBy    User?              @relation(fields: [dispensedById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())

  lines DispensationLine[]

  @@unique([tenantId, clientRef])
  @@index([tenantId, createdAt])
  @@index([prescriptionId])
}

model DispensationLine {
  id             String       @id @default(uuid())
  dispensationId String
  dispensation   Dispensation @relation(fields: [dispensationId], references: [id], onDelete: Cascade)
  itemId         String
  item           StockItem    @relation(fields: [itemId], references: [id])
  batchId        String
  batch          StockBatch   @relation(fields: [batchId], references: [id])
  qty            Int
  unitPrice      Decimal      @db.Decimal(10, 2)
  gstPercent     Decimal      @default(0) @db.Decimal(5, 2)
  lineTotal      Decimal      @db.Decimal(10, 2)

  @@index([dispensationId])
}

// ───────────────────────── Dental chart & treatment plans ─────────────────────────
enum PlanStatus {
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlanItemStatus {
  PLANNED
  DONE
  CANCELLED
}

/// Chart history: one row per finding. The current state of a tooth is its newest non-deleted row.
model ToothRecord {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  /// FDI number: 11-18, 21-28, 31-38, 41-48 permanent; 51-55, 61-65, 71-75, 81-85 deciduous.
  tooth        Int
  /// Surfaces affected, e.g. "MOD" (mesial, occlusal, distal); null = whole tooth.
  surfaces     String?
  /// HEALTHY, CARIES, FILLED, CROWN, ROOT_CANAL, IMPLANT, FRACTURED, MISSING, EXTRACTED, OTHER
  condition    String
  notes        String?
  recordedById String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([tenantId, patientId, tooth])
}

model TreatmentPlan {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  patientId   String
  patient     Patient    @relation(fields: [patientId], references: [id])
  title       String
  status      PlanStatus @default(PROPOSED)
  notes       String?
  createdById String?
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?

  items TreatmentPlanItem[]

  @@index([tenantId, patientId])
}

model TreatmentPlanItem {
  id         String         @id @default(uuid())
  planId     String
  plan       TreatmentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  tooth      Int?
  procedure  String
  price      Decimal        @db.Decimal(10, 2)
  gstPercent Decimal        @default(0) @db.Decimal(5, 2)
  status     PlanItemStatus @default(PLANNED)
  doneAt     DateTime?
  sortOrder  Int            @default(0)
  /// Set when the item has been put on an invoice (plain id, no foreign key).
  invoiceId  String?

  @@index([planId])
}

// ───────────────────────── Exercise & rehab plans ─────────────────────────
enum ExercisePlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model ExerciseTemplate {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  category     String    @default("General")
  description  String?
  sets         Int?
  reps         Int?
  holdSeconds  Int?
  instructions String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@unique([tenantId, name])
}

model ExercisePlan {
  id        String             @id @default(uuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  patientId String
  patient   Patient            @relation(fields: [patientId], references: [id])
  doctorId  String?
  doctor    User?              @relation("ExerciseDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  title     String
  status    ExercisePlanStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  notes     String?
  createdAt DateTime           @default(now())
  deletedAt DateTime?

  items    ExercisePlanItem[]
  progress ExerciseProgress[]

  @@index([tenantId, patientId])
}

model ExercisePlanItem {
  id           String       @id @default(uuid())
  planId       String
  plan         ExercisePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  templateId   String?
  name         String
  sets         Int?
  reps         Int?
  holdSeconds  Int?
  /// e.g. "twice daily"
  frequency    String?
  instructions String?
  sortOrder    Int          @default(0)
  deletedAt    DateTime?

  @@index([planId])
}

model ExerciseProgress {
  id               String       @id @default(uuid())
  tenantId         String
  planId           String
  plan             ExercisePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  patientId        String
  recordedAt       DateTime     @default(now())
  /// 0 (none) to 10 (worst)
  painScore        Int?
  /// 0-100 share of the plan the patient completed
  adherencePercent Int?
  notes            String?
  recordedById     String?

  @@index([planId, recordedAt])
}

// ───────────────────────── Pathology lab ─────────────────────────
enum LabOrderStatus {
  ORDERED
  COLLECTED
  RESULTED
  CANCELLED
}

model LabTest {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  code       String?
  category   String    @default("Biochemistry")
  sampleType String?
  unit       String?
  refLow     Decimal?  @db.Decimal(12, 3)
  refHigh    Decimal?  @db.Decimal(12, 3)
  /// Free-text range for non-numeric tests, e.g. "Negative".
  refText    String?
  price      Decimal   @db.Decimal(10, 2)
  gstPercent Decimal   @default(0) @db.Decimal(5, 2)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@unique([tenantId, name])
}

model LabOrder {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  /// Per-clinic running number from Tenant.labSeq, e.g. LAB-000042.
  orderNo       String
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id])
  visitId       String?
  orderedById   String?
  orderedBy     User?          @relation("LabOrderedBy", fields: [orderedById], references: [id], onDelete: SetNull)
  status        LabOrderStatus @default(ORDERED)
  clinicalNotes String?
  clientRef     String?
  /// Set when billed (plain id, no foreign key).
  invoiceId     String?
  collectedAt   DateTime?
  resultedAt    DateTime?
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  items LabOrderItem[]

  @@unique([tenantId, orderNo])
  @@unique([tenantId, clientRef])
  @@index([tenantId, status])
  @@index([patientId])
}

model LabOrderItem {
  id            String    @id @default(uuid())
  orderId       String
  order         LabOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testId        String?
  /// Snapshots, so later catalogue edits never change an issued order or report.
  testName      String
  unit          String?
  refLow        Decimal?  @db.Decimal(12, 3)
  refHigh       Decimal?  @db.Decimal(12, 3)
  refText       String?
  price         Decimal   @db.Decimal(10, 2)
  gstPercent    Decimal   @default(0) @db.Decimal(5, 2)
  resultValue   String?
  resultNumeric Decimal?  @db.Decimal(14, 4)
  /// NORMAL, LOW, HIGH, CRITICAL (set by the app from the reference range, or by the technician)
  flag          String?
  remarks       String?
  resultedAt    DateTime?
  resultedById  String?
  sortOrder     Int       @default(0)

  @@index([orderId])
}

// ───────────────────────── Radiology & imaging ─────────────────────────
enum ImagingStatus {
  ORDERED
  SCHEDULED
  PERFORMED
  REPORTED
  CANCELLED
}

model ImagingStudyType {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  /// XRAY, ULTRASOUND, CT, MRI, ECG, OTHER
  modality   String
  name       String
  bodyPart   String?
  price      Decimal   @db.Decimal(10, 2)
  gstPercent Decimal   @default(0) @db.Decimal(5, 2)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@unique([tenantId, name])
}

model ImagingOrder {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  /// Per-clinic running number from Tenant.imagingSeq, e.g. IMG-000007.
  orderNo       String
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  visitId       String?
  studyTypeId   String?
  /// Snapshots from the study type at order time.
  studyName     String
  modality      String
  bodyPart      String?
  price         Decimal       @db.Decimal(10, 2)
  gstPercent    Decimal       @default(0) @db.Decimal(5, 2)
  clinicalInfo  String?
  status        ImagingStatus @default(ORDERED)
  orderedById   String?
  orderedBy     User?         @relation("ImagingOrderedBy", fields: [orderedById], references: [id], onDelete: SetNull)
  scheduledAt   DateTime?
  performedAt   DateTime?
  performedById String?
  findings      String?
  impression    String?
  reportedAt    DateTime?
  reportedById  String?
  clientRef     String?
  invoiceId     String?
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?

  attachments ImagingAttachment[]

  @@unique([tenantId, orderNo])
  @@unique([tenantId, clientRef])
  @@index([tenantId, status])
  @@index([patientId])
}

/// A scan, X-ray image or outside report attached to an imaging order. The file lives in the private Blob store
/// under `blobPath` and is only ever served through an authenticated, tenant-checked route.
model ImagingAttachment {
  id           String       @id @default(uuid())
  tenantId     String
  orderId      String
  order        ImagingOrder @relation(fields: [orderId], references: [id])
  blobPath     String
  filename     String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  @@index([orderId])
  @@index([tenantId])
}

// ───────────────────────── IPD, ICU & bed management ─────────────────────────
enum WardType {
  GENERAL
  SEMI_PRIVATE
  PRIVATE
  ICU
  NICU
  HDU
  OTHER
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

model Ward {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  type      WardType @default(GENERAL)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  beds Bed[]

  @@unique([tenantId, name])
}

model Bed {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  wardId    String
  ward      Ward     @relation(fields: [wardId], references: [id])
  label     String
  dailyRate Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  admissions Admission[]
  stays      BedStay[]

  @@unique([wardId, label])
  @@index([tenantId])
}

/// A bed holds at most one ADMITTED admission: enforced by a partial unique index added in the migration SQL.
model Admission {
  id                  String          @id @default(uuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  /// Per-clinic running number from Tenant.admissionSeq, e.g. ADM-000012.
  admissionNo         String
  patientId           String
  patient             Patient         @relation(fields: [patientId], references: [id])
  doctorId            String
  doctor              User            @relation("AdmissionDoctor", fields: [doctorId], references: [id])
  bedId               String?
  bed                 Bed?            @relation(fields: [bedId], references: [id])
  status              AdmissionStatus @default(ADMITTED)
  admittedAt          DateTime        @default(now())
  expectedDischargeAt DateTime?
  dischargedAt        DateTime?
  reason              String?
  diagnosis           String?
  notes               String?
  clientRef           String?
  /// Bed-charge invoice created at discharge (plain id, no foreign key).
  invoiceId           String?
  createdById         String?
  createdAt           DateTime        @default(now())
  deletedAt           DateTime?

  stays     BedStay[]
  chart     ChartEntry[]
  discharge DischargeSummary?

  @@unique([tenantId, admissionNo])
  @@unique([tenantId, clientRef])
  @@index([tenantId, status])
  @@index([patientId])
}

/// Bed history for an admission (transfers close one stay and open the next). `rate` is a snapshot of the daily rate.
model BedStay {
  id          String    @id @default(uuid())
  tenantId    String
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  bedId       String
  bed         Bed       @relation(fields: [bedId], references: [id])
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  rate        Decimal   @db.Decimal(10, 2)

  @@index([admissionId])
}

/// Nursing notes and ICU observations. All value fields are optional; a row may be just a note.
model ChartEntry {
  id           String    @id @default(uuid())
  tenantId     String
  admissionId  String
  admission    Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  /// NURSING or ICU
  kind         String    @default("NURSING")
  recordedAt   DateTime  @default(now())
  recordedById String?
  systolic     Int?
  diastolic    Int?
  pulse        Int?
  respRate     Int?
  spo2         Int?
  tempC        Decimal?  @db.Decimal(4, 1)
  gcs          Int?
  intakeMl     Int?
  outputMl     Int?
  notes        String?

  @@index([admissionId, recordedAt])
}

// ───────────────────────── Discharge summary ─────────────────────────
enum DischargeStatus {
  DRAFT
  FINAL
}

model DischargeSummary {
  id                     String          @id @default(uuid())
  tenantId               String
  tenant                 Tenant          @relation(fields: [tenantId], references: [id])
  admissionId            String          @unique
  admission              Admission       @relation(fields: [admissionId], references: [id])
  patientId              String
  patient                Patient         @relation(fields: [patientId], references: [id])
  doctorId               String
  doctor                 User            @relation("DischargeDoctor", fields: [doctorId], references: [id])
  status                 DischargeStatus @default(DRAFT)
  diagnosis              String?
  courseInHospital       String?
  proceduresDone         String?
  investigationsSummary  String?
  conditionAtDischarge   String?
  medicationsOnDischarge String?
  adviceFollowUp         String?
  followUpDate           DateTime?
  finalizedAt            DateTime?
  finalizedById          String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([tenantId, status])
}
